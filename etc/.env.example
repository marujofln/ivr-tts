# Copy to etc/.env and adjust. Every key can also be set as an environment variable.

freeswitch_host = "localhost"
freeswitch_port = 8021
freeswitch_password = "ClueCon"
freeswitch_recording_path = "/var/lib/freeswitch/recordings"
freeswitch_listen_loop = 0.1
freeswitch_keep_connected = 2           # seconds between connection checks
freeswitch_connection_max_retry = 0     # connection attempts, 0 = infinite
freeswitch_connection_wait_retry = 3    # seconds to wait between attempts

dialer_domain = "pbx.example.com"
dialer_dialplan_context = "pbx.example.com"
dialer_dialplan_dst = "99"              # extension that sends the call to the IVR socket
dialer_max_concurrent_calls = 2
dialer_job_wait_time = 10               # seconds to wait when there is nothing to dial
dialer_callerid_number = "0000"
dialer_callerid_name = "IVR TTS Dialer"

ivr_company_name = "Example Company"
ivr_contact_phone = "zero oitocentos, zero zero zero, zero zero zero zero"  # as spoken by TTS

postgres_host = "localhost"
postgres_port = 5432
postgres_user = "ivr_tts"
postgres_password = "change-me"
postgres_database = "ivr_tts"
# database_url = "postgresql+psycopg2://user:pass@host:5432/db"  # overrides postgres_*

fief_base_url = "https://auth.example.com"
fief_client_id = "change-me"
fief_client_secret = "change-me"
